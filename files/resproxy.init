#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=05

. /lib/functions.sh

# OpenWrt's APK post-install starts init scripts automatically. The managed
# updater must finish releasing recovery RAM before activating the new daemon.
resproxy_update_installing() {
	local state=/var/run/sb-gateway-upgrade worker
	[ -f "$state/busy" ] && [ "$(cat "$state/phase" 2>/dev/null)" = installing ] || return 1
	read -r worker < "$state/worker.pid" 2>/dev/null || return 1
	case "$worker" in ''|*[!0-9]*) return 1;; esac
	[ "$worker" -gt 1 ] && kill -0 "$worker" 2>/dev/null || return 1
	[ -r "/proc/$worker/cmdline" ] || return 1
	tr '\000' ' ' < "/proc/$worker/cmdline" | grep -Eq '^/bin/sh /tmp/\.sb-gateway-upgrade-runner (install|github-install-worker)( |$)'
}

start_service() {
	resproxy_update_installing && return 0
	config_load resproxy
	local enabled route_enabled
	config_get_bool enabled main enabled 0
	config_get_bool route_enabled main route_enabled 0
	if [ "$enabled" != "1" ]; then
		/usr/libexec/resproxy-firewall remove || return 1
		rm -f /var/run/resproxy/capture-protected.active
		/usr/bin/resproxyd dns-restore || logger -t resproxy 'DNS handoff restore failed'
		return 0
	fi

	if [ "$route_enabled" != 1 ]; then
		/usr/libexec/resproxy-firewall remove || return 1
		rm -f /var/run/resproxy/capture-protected.active
	fi
	# Repeating Start must not replace a healthy live policy with a guard.
	if ! pgrep -f '^/usr/bin/resproxyd run$' >/dev/null 2>&1; then
		/usr/bin/resproxyd capture-protect || logger -t resproxy 'early LAN protection failed; starting supervised daemon to retry'
	fi
	procd_open_instance gateway
	procd_set_param command /usr/bin/resproxyd run
	procd_set_param respawn 3600 15 0
	procd_set_param env RESPROXY_PROCD_INSTANCE=gateway
	# Initial core/config preparation has a larger lease; daemon narrows it
	# to 90 seconds after health progress and local API are confirmed.
	procd_set_param watchdog 1 300
	procd_set_param term_timeout 90
	# Descriptor allowance follows router RAM (one per 32 KiB), with the
	# existing small-router floor and a finite ceiling. Nothing is preallocated.
	local mem_key mem_value mem_unit fd_limit=8192 fd_ceiling=65536
	while read -r mem_key mem_value mem_unit; do
		[ "$mem_key" = 'MemTotal:' ] || continue
		case "$mem_value" in
			''|*[!0-9]*) ;;
			*) fd_limit=$((mem_value / 32)) ;;
		esac
		break
	done < /proc/meminfo
	[ "$fd_limit" -ge 8192 ] || fd_limit=8192
	[ "$fd_limit" -le 65536 ] || fd_limit=65536
	read -r fd_ceiling < /proc/sys/fs/nr_open || fd_ceiling=65536
	case "$fd_ceiling" in
		''|*[!0-9]*) fd_ceiling=65536 ;;
	esac
	[ "$fd_limit" -le "$fd_ceiling" ] || fd_limit="$fd_ceiling"
	procd_set_param limits nofile="$fd_limit $fd_limit"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger resproxy
}

# Monitoring changes update the health contract in the running daemon.
# Restart only when it explicitly reports a structural configuration change.
reload_service() {
    local result=0
    /usr/bin/resproxyd reload || result=$?
    case "$result" in
        0) return 0 ;;
        2) restart ;;
        *) logger -t resproxy 'configuration reload failed; retry Apply'; return "$result" ;;
    esac
}

extra_command "stop_for_update" "Stop the daemon while preserving source-policy protection"

restart() {
 config_load resproxy
 local enabled route_enabled
 config_get_bool enabled main enabled 0
 config_get_bool route_enabled main route_enabled 0
 if [ "$enabled" != 1 ] || [ "$route_enabled" != 1 ]; then
  stop "$@" || return 1
  start "$@"
  return $?
 fi
 /usr/bin/resproxyd capture-protect || return 1
 RESPROXY_KEEP_CAPTURE=1 stop "$@" || return 1
 start "$@"
}

shutdown() {
 stop_for_update "$@"
}

stop_for_update() {
 /usr/bin/resproxyd capture-protect || return 1
 RESPROXY_KEEP_CAPTURE=1 stop "$@"
}

stop_service() {
	resproxy_stopping_pid="$(pgrep -f '^/usr/bin/resproxyd run$' 2>/dev/null || :)"
}

# rc.common calls this after requesting termination from procd. Wait until the
# daemon exits, so its deferred cleanup cannot race an independent restoration.
service_stopped() {
 local waited=0 pid alive
 while [ "$waited" -lt 95 ]; do
  alive=0
  for pid in $resproxy_stopping_pid; do
   [ -r "/proc/$pid/cmdline" ] && tr '\000' ' ' 2>/dev/null < "/proc/$pid/cmdline" | grep -q '^/usr/bin/resproxyd run ' && alive=1
  done
  [ "$alive" = 1 ] || break
  waited=$((waited+1)); sleep 1
 done
 rm -f /var/run/resproxy/crash-attempt.json /var/run/resproxy/crash-fallback.active
 /usr/bin/resproxyd dns-restore || logger -t resproxy 'DNS handoff restore failed after stop'
 if [ "${RESPROXY_KEEP_CAPTURE:-0}" = 1 ]; then
  # Reassert after all old startup/cleanup work has finished.
  /usr/bin/resproxyd capture-protect || return 1
 else
  /usr/libexec/resproxy-firewall remove || return 1
  rm -f /var/run/resproxy/capture-protected.active
 fi
}
