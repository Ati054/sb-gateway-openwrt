#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=05

. /lib/functions.sh

start_service() {
	config_load resproxy
	local enabled
	config_get_bool enabled main enabled 0
	if [ "$enabled" != "1" ]; then
		/usr/bin/resproxyd dns-restore || logger -t resproxy 'DNS handoff restore failed'
		return 0
	fi

	procd_open_instance gateway
	procd_set_param command /usr/bin/resproxyd run
	procd_set_param respawn 3600 15 0
	procd_set_param env RESPROXY_PROCD_INSTANCE=gateway
	# Initial core/config preparation has a larger lease; daemon narrows it
	# to 90 seconds after health progress and local API are confirmed.
	procd_set_param watchdog 1 300
	procd_set_param term_timeout 90
	procd_set_param limits nofile="8192 8192"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger resproxy
}

# Monitoring changes update the health contract in the running daemon.
# Restart only when it explicitly reports a structural configuration change.
reload_service() {
    local result=0
    /usr/bin/resproxyd reload || result=$?
    case "$result" in
        0) return 0 ;;
        2) restart ;;
        *) logger -t resproxy 'configuration reload failed; retry Apply'; return "$result" ;;
    esac
}

stop_service() {
	resproxy_stopping_pid="$(pgrep -f '^/usr/bin/resproxyd run$' 2>/dev/null || :)"
	/usr/libexec/resproxy-firewall remove >/dev/null 2>&1 || true
}

# rc.common calls this after requesting termination from procd. Wait until the
# daemon exits, so its deferred cleanup cannot race an independent restoration.
service_stopped() {
 local waited=0 pid alive
 while [ "$waited" -lt 95 ]; do
  alive=0
  for pid in $resproxy_stopping_pid; do
   [ -r "/proc/$pid/cmdline" ] && tr '\000' ' ' < "/proc/$pid/cmdline" | grep -q '^/usr/bin/resproxyd run ' && alive=1
  done
  [ "$alive" = 1 ] || break
  waited=$((waited+1)); sleep 1
 done
 /usr/bin/resproxyd dns-restore || logger -t resproxy 'DNS handoff restore failed after stop'
}
