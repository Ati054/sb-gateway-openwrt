config main 'main'
	option enabled '0'
	option route_enabled '0'
	option ipv6_mode 'proxy'
	list bypass_cidrs '0.0.0.0/8'
	list bypass_cidrs '10.0.0.0/8'
	list bypass_cidrs '100.64.0.0/10'
	list bypass_cidrs '127.0.0.0/8'
	list bypass_cidrs '169.254.0.0/16'
	list bypass_cidrs '172.16.0.0/12'
	list bypass_cidrs '192.168.0.0/16'
	list bypass_cidrs '224.0.0.0/4'
	list bypass_cidrs '240.0.0.0/4'
	list bypass_cidrs '::/127'
	list bypass_cidrs 'fc00::/7'
	list bypass_cidrs 'fe80::/10'
	list bypass_cidrs 'ff00::/8'
	option subscription_url ''
	option provider_id 'primary'
	option update_mode 'automatic'
	option update_interval_seconds '1800'
	option max_nodes '1000'
	option ruleset_update_mode 'automatic'
	option ruleset_update_interval_seconds '86400'
	option dns_mode 'proxy-only'
	option dns_handoff_confirmed '0'
	option dns_proxy_protocol 'doh'
	option dns_direct_protocol 'doh'
	option dns_proxy_provider 'cloudflare'
	option dns_direct_provider 'cloudflare'
	option dns_proxy_url 'https://1.1.1.1/dns-query'
	option dns_direct_url 'https://1.1.1.1/dns-query'
	option dns_port '1053'
	option api_port '10085'
	option transparent_port '12345'
	option http_port '19080'
	option probe_base_port '19082'
	option dns_policy_base_port '19100'
	option active_liveness_seconds '3'
	option active_check_seconds '60'
	option probe_batch_size '10'
	option history_limit_kib '2048'
	option switch_improvement_ms '50'

config policy
	option id 'main'
	option mode 'best'
	# Add ordered selectors, for example: list selection_order 'country:CA'
	# Add source_cidrs for device-specific policies; the unscoped list is default.
