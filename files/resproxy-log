#!/bin/sh
# Read the bounded OpenWrt RAM journal; never create an application disk log.
set -eu
kind="${1:-events}"
lines="${2:-200}"
case "$kind" in events|errors|xray|all) ;; *) exit 2 ;; esac
case "$lines" in 50|200|500) ;; *) exit 2 ;; esac
{
case "$kind" in
 events) logread 2>/dev/null | grep -Ei 'resproxyd|resproxy:|agent:' | tail -n "$lines" || : ;;
 errors) logread 2>/dev/null | grep -Ei '(resproxyd|resproxy:|agent:|xray).*([Ee]rror|[Ww]arn|[Ff]ail|[Bb]lock|rollback)' | tail -n "$lines" || : ;;
 xray) logread 2>/dev/null | grep -Ei 'xray' | tail -n "$lines" || : ;;
 all) logread 2>/dev/null | tail -n "$lines" || : ;;
esac
} | LC_ALL=C awk 'BEGIN { first=1 } { buffer[++last]=$0; size+=length($0)+1; while(size>65536) { size-=length(buffer[first])+1; delete buffer[first++] } } END { for(i=first;i<=last;i++) print buffer[i] }'
