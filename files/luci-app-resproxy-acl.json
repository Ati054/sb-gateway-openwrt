{
  "luci-app-resproxy": {
    "description": "SB Gateway for OpenWrt configuration and status",
    "read": {
      "cgi-io": [
        "exec"
      ],
      "uci": [
        "resproxy",
        "dhcp"
      ],
      "file": {
        "/usr/libexec/sb-gateway-upgrade status": [
          "exec"
        ],
        "/usr/libexec/resproxy-status": [
          "exec"
        ],
        "/usr/libexec/resproxy-health": [
          "exec"
        ],
        "/usr/libexec/resproxy-locations": [
          "exec"
        ],
        "/usr/libexec/resproxy-log": [
          "exec"
        ],
        "/usr/libexec/resproxy-rulesets": [
          "exec"
        ],
        "/usr/libexec/resproxy-plugins status": [
          "exec"
        ],
        "/var/run/resproxy/health-state/monitor.json": [
          "read"
        ],
        "/var/run/resproxy/health-state/selector-runtime.json": [
          "read"
        ],
        "/var/run/resproxy/catalog-summary.json": [
          "read"
        ],
        "/var/run/resproxy/subscription-status.json": [
          "read"
        ],
        "/var/run/resproxy/resources.json": [
          "read"
        ],
        "/var/run/resproxy/dns-status.json": [
          "read"
        ],
        "/var/run/resproxy/dns-interop.json": [
          "read"
        ],
        "/tmp/run/resproxy/health-state/monitor.json": [
          "read"
        ],
        "/tmp/run/resproxy/health-state/selector-runtime.json": [
          "read"
        ],
        "/tmp/run/resproxy/catalog-summary.json": [
          "read"
        ],
        "/tmp/run/resproxy/subscription-status.json": [
          "read"
        ],
        "/tmp/run/resproxy/resources.json": [
          "read"
        ],
        "/tmp/run/resproxy/dns-status.json": [
          "read"
        ],
        "/tmp/run/resproxy/dns-interop.json": [
          "read"
        ]
      },
      "ubus": {
        "file": [
          "exec",
          "read"
        ],
        "service": [
          "list"
        ]
      }
    },
    "write": {
      "uci": [
        "resproxy"
      ],
      "file": {
        "/usr/libexec/sb-gateway-upgrade inspect": [
          "exec"
        ],
        "/usr/libexec/sb-gateway-upgrade fingerprint": [
          "exec"
        ],
        "/usr/libexec/sb-gateway-upgrade start *": [
          "exec"
        ],
        "/tmp/sb-gateway-upgrade.apk": [
          "write"
        ],
        "/usr/libexec/resproxy-refresh": [
          "exec"
        ],
        "/usr/libexec/resproxy-rulesets-refresh": [
          "exec"
        ],
        "/etc/init.d/resproxy": [
          "exec"
        ],
        "/usr/libexec/resproxy-plugins install v2ray-plugin": [
          "exec"
        ],
        "/usr/libexec/resproxy-plugins install obfs-local": [
          "exec"
        ],
        "/usr/libexec/sb-gateway-upgrade check": [
          "exec"
        ],
        "/usr/libexec/sb-gateway-upgrade github-start": [
          "exec"
        ]
      },
      "ubus": {
        "file": [
          "exec"
        ]
      },
      "cgi-io": [
        "upload"
      ]
    }
  }
}
