include "/var/run/resproxy/firewall*.nft"

# TProxy delivers forwarded traffic locally. Accept only our kernel-marked
# transparent sockets before fw4's router SYN allowance and zone input policy.
# Direct router access and traffic without a transparent listener stay subject
# to the user's firewall policy.
insert rule inet fw4 input meta mark 0x5253 meta l4proto { tcp, udp } socket transparent 1 counter accept comment "sb-gateway: TProxy delivery"
