#!/bin/sh
# Only the selected LAN ingress is captured. Router OUTPUT and all WireGuard
# interfaces stay outside this table, including the independent management VPN.
set -eu
umask 077

action="${1:-}"
interface="${2:-}"
port="${3:-}"
dns_port="${4:-0}"
ready=0
client_scope=
restore_config_stdin=0
for option in "$@"; do
	case "$option" in --clients=*) client_scope="$option";; --restore-config-stdin) restore_config_stdin=1;; esac
done
[ "$action" != ready ] || { ready=1; action=apply; }
mkdir -p /var/run/resproxy
rules=/var/run/resproxy/firewall.nft
[ -f "$rules" ] || : > "$rules"
exec 9>/var/run/resproxy-firewall.lock
flock -x 9

case "$action" in
	apply|emergency|guard|restore)
		case "$interface" in
			''|*[!A-Za-z0-9_.:-]*) echo 'invalid LAN interface' >&2; exit 1 ;;
		esac
		[ "${#interface}" -le 15 ] || exit 1
		case "$port" in
			''|*[!0-9]*) echo 'invalid transparent port' >&2; exit 1 ;;
		esac
		[ "$port" -ge 1024 ] && [ "$port" -le 65535 ] || exit 1
		case "$dns_port" in
			''|*[!0-9]*) echo 'invalid LAN DNS port' >&2; exit 1 ;;
		esac
		[ "$dns_port" -eq 0 ] || { [ "$dns_port" -ge 1024 ] && [ "$dns_port" -le 65535 ] && [ "$dns_port" -ne "$port" ]; } || exit 1
		;;
	remove) ;;
	*) echo 'usage: resproxy-firewall {apply|emergency|guard IFNAME PORT DNSPORT IPV6MODE [IP...]|remove}' >&2; exit 1 ;;
esac

temporary="$(mktemp /var/run/resproxy/.firewall-new.XXXXXX)"
backup="$(mktemp /var/run/resproxy/.firewall-old.XXXXXX)"
batch="$(mktemp /var/run/resproxy/.firewall-batch.XXXXXX)"
trap 'rm -f "$temporary" "$backup" "$batch"' EXIT
cp -p "$rules" "$backup"

if [ "$action" = restore ]; then
	if [ "$restore_config_stdin" = 1 ]; then
		/usr/bin/resproxyd capture-restore-rules --config-stdin > "$temporary"
	else
		/usr/bin/resproxyd capture-restore-rules > "$temporary"
	fi
	read -r hash tag action interface port dns_port extra < "$temporary"
	[ "$hash" = '#' ] && [ "$tag" = resproxy-restore ] && [ -z "${extra:-}" ] || exit 1
	case "$action" in
		skip) exit 0 ;;
		apply|emergency|guard) ;;
		*) exit 1 ;;
	esac
elif [ "$action" != remove ]; then
	[ "$action" = guard ] || [ -d "/sys/class/net/$interface/bridge" ] || {
		echo 'capture interface must be an existing LAN bridge' >&2
		exit 1
	}
	# Shared Go validation/rendering keeps the displayed system exclusions and
	# the actual firewall rules identical. Pass validated arguments as argv.
	shift
	renderer=capture-rules
	[ "$action" != emergency ] || renderer=capture-emergency-rules
	[ "$action" != guard ] || renderer=capture-guard-rules
	/usr/bin/resproxyd "$renderer" "$@" > "$temporary"

fi

if [ "$action" = apply ]; then
	[ -d "/sys/class/net/$interface/bridge" ] || { echo 'capture interface must be an existing LAN bridge' >&2; exit 1; }
fi

# Serialize with fw4's own start/reload/stop transaction. In particular, its
# ruleset-post include and our live delivery exemption must never race into copies.
exec 8>/var/run/fw4.lock
flock -x 8

mv "$temporary" "$rules"
if [ "$action" != remove ] && [ "$action" != guard ] && ! fw4 check; then
	mv "$backup" "$rules"
	exit 1
fi

route_added=0
rule_added=0
route6_added=0
rule6_added=0
rollback_policy_routes() {
	[ "$rule6_added" = 0 ] || ip -6 rule del iif "$interface" fwmark 0x5253/0xffffffff table 20253 priority 10552 2>/dev/null || :
	[ "$route6_added" = 0 ] || ip -6 route del local ::/0 dev lo table 20253 2>/dev/null || :
	[ "$rule_added" = 0 ] || ip -4 rule del iif "$interface" fwmark 0x5253/0xffffffff table 20253 priority 10552 2>/dev/null || :
	[ "$route_added" = 0 ] || ip -4 route del local 0.0.0.0/0 dev lo table 20253 2>/dev/null || :
}
if [ "$action" = apply ]; then
	if ! ip -4 route show table 20253 2>/dev/null | grep -q '^local default dev lo'; then
		if ! ip -4 route replace local 0.0.0.0/0 dev lo table 20253; then
			mv "$backup" "$rules"
			exit 1
		fi
		route_added=1
	fi
	# Source validation performs its reverse lookup with loopback as the input
	# interface. Keep that lookup outside our local-default table even when a
	# VPN enables src_valid_mark and rp_filter. Do not disable either sysctl.
	# A separate priority also lets us migrate the old unscoped rule only after
	# the replacement has been installed, without a gap in marked delivery.
	if ! ip -4 rule show | grep -F "iif $interface lookup 20253" | grep -q '^10552:.*fwmark 0x5253 '; then
		if ! ip -4 rule add iif "$interface" fwmark 0x5253/0xffffffff table 20253 priority 10552; then
			mv "$backup" "$rules"
			rollback_policy_routes
			exit 1
		fi
		rule_added=1
	fi
	if ! ip -6 route show table 20253 2>/dev/null | grep -q '^local default dev lo'; then
		if ! ip -6 route replace local ::/0 dev lo table 20253; then
			mv "$backup" "$rules"
			rollback_policy_routes
			exit 1
		fi
		route6_added=1
	fi
	if ! ip -6 rule show | grep -F "iif $interface lookup 20253" | grep -q '^10552:.*fwmark 0x5253 '; then
		if ! ip -6 rule add iif "$interface" fwmark 0x5253/0xffffffff table 20253 priority 10552; then
			mv "$backup" "$rules"
			rollback_policy_routes
			exit 1
		fi
		rule6_added=1
	fi
fi

# A single nft batch replaces our private tables atomically. Keep the fw4
# ruleset-post include for later firewall reloads, but do not reload the whole
# firewall merely because this service starts or stops.
# Listing tables only reads their names, rather than enumerating every set in
# fw4 just to discover whether the table exists.
if ! existing_tables="$(nft list tables)"; then
	mv "$backup" "$rules"
	rollback_policy_routes
	exit 1
fi
if printf '%s\n' "$existing_tables" | grep -Fxq 'table inet fw4'; then
	if ! input_rules="$(nft -n -s -t -a list chain inet fw4 input)"; then
		mv "$backup" "$rules"
		rollback_policy_routes
		exit 1
	fi
	if [ "$action" != remove ]; then
		if ! printf '%s\n' "$input_rules" | grep -Fq 'comment "sb-gateway: TProxy delivery"'; then
			printf '%s\n' 'insert rule inet fw4 input meta mark 0x5253 meta l4proto { tcp, udp } socket transparent 1 counter accept comment "sb-gateway: TProxy delivery"' >> "$batch"
		fi
	else
		# Only remove our tagged rules, leaving the user's input policy untouched.
		for handle in $(printf '%s\n' "$input_rules" | sed -n 's/.*comment "sb-gateway: TProxy delivery" # handle \([0-9]*\)$/\1/p'); do
			case "$handle" in ''|*[!0-9]*) exit 1;; esac
			printf 'delete rule inet fw4 input handle %s\n' "$handle" >> "$batch"
		done
	fi
fi
if printf '%s\n' "$existing_tables" | grep -Fxq 'table ip resproxy'; then
	printf 'delete table ip resproxy\n' >> "$batch"
fi
if printf '%s\n' "$existing_tables" | grep -Fxq 'table ip6 resproxy6'; then
	printf 'delete table ip6 resproxy6\n' >> "$batch"
fi
if [ "$action" != remove ]; then
	printf 'include "%s"\n' "$rules" >> "$batch"
fi
if ! nft -c -f "$batch" || ! nft -f "$batch"; then
	mv "$backup" "$rules"
	rollback_policy_routes
	exit 1
fi

if [ "$action" = apply ]; then
	# Retire legacy rules only after the scoped replacement and nft commit.
	for family in -4 -6; do
		while ip "$family" rule del fwmark 0x5253/0xffffffff table 20253 priority 10553 2>/dev/null; do :; done
	done
fi

# Phase markers and their kernel rules commit under the same lock. A queued
# restore therefore cannot reinstall a guard after startup has completed.
if [ "$action" = apply ] && [ "$dns_port" -ne 0 ] && grep -Fq 'th dport 53 tproxy to 127.0.0.2:' "$rules"; then
	# Old REDIRECT conntrack bindings outlive nft rules. Retire only mappings
	# into our DNS port from this LAN, retaining local DNS and unrelated flows.
	if retired="$(/usr/bin/resproxyd capture-prune-dns "$interface" "$dns_port" "$client_scope")"; then
		[ -z "$retired" ] || logger -t resproxy "retired $retired legacy DNS mappings"
	else
		logger -t resproxy 'legacy DNS mapping cleanup failed; existing sessions may need reconnecting'
	fi
fi

if [ "$action" = guard ]; then
	printf 'startup or transition protection\n' > /var/run/resproxy/capture-protected.active
elif [ "$action" = emergency ]; then
	printf 'source-policy WAN fallback\n' > /var/run/resproxy/crash-fallback.active
elif [ "$ready" = 1 ] || [ "$action" = remove ]; then
	rm -f /var/run/resproxy/capture-protected.active /var/run/resproxy/crash-fallback.active
fi

if [ "$action" = remove ]; then
	for family in -4 -6; do
		for priority in 10552 10553; do
			while ip "$family" rule del fwmark 0x5253/0xffffffff table 20253 priority "$priority" 2>/dev/null; do :; done
		done
	done
	ip -6 route del local ::/0 dev lo table 20253 2>/dev/null || :
	ip -4 route del local 0.0.0.0/0 dev lo table 20253 2>/dev/null || :
fi
