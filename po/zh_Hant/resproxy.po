msgstr "已在 Xray 中確認"

msgid "not confirmed in Xray"
msgstr "未在 Xray 中確認"

msgid "Runtime error"
msgstr "執行階段錯誤"

msgid "No route status is available yet."
msgstr "暫無路由狀態。"

msgid "Client-only proxy. Subscription refreshes do not restart the running Xray core."
msgstr "僅提供用戶端代理。更新訂閱不會重新啟動正在執行的 Xray。"

msgid "Current state"
msgstr "目前狀態"

msgid "Service"
msgstr "服務"

msgid "Active catalog"
msgstr "使用中的節點目錄"

msgid "%d nodes"
msgstr "%d 個節點"

