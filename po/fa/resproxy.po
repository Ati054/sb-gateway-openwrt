msgstr "سرورها و حالت"

msgid "Devices"
msgstr "دستگاه‌ها"

msgid "Health checks"
msgstr "بررسی سلامت"

msgid "Route list ID"
msgstr "شناسهٔ فهرست مسیریابی"

msgid "Use 1–32 lowercase Latin letters, digits, or hyphens; start with a letter."
msgstr "از ۱ تا ۳۲ حرف کوچک لاتین، رقم یا خط تیره استفاده کنید؛ با حرف شروع شود."

msgid "Selection mode"
msgstr "حالت انتخاب"

msgid "Best available"
msgstr "بهترین گرهٔ در دسترس"

msgid "Priority / reserve"
msgstr "اولویت / پشتیبان"

msgid "Selected locations in order"
msgstr "مکان‌های انتخاب‌شده به‌ترتیب"

msgid "Examples: country:CA, region:europe, city:CA:Toronto. In priority mode, order is used for reserve selection."
msgstr "نمونه‌ها: country:CA، region:europe، city:CA:Toronto. در حالت اولویت، ترتیب برای انتخاب گرهٔ پشتیبان استفاده می‌شود."

msgid "Client IP addresses or subnets"
msgstr "نشانی‌های IP یا زیرشبکه‌های کلاینت"

msgid "Examples: 192.168.1.20/32 for one device, 192.168.1.0/24 for a subnet. Leave empty for the default list. Give devices fixed DHCP leases so the mapping remains stable."
msgstr "نمونه: 192.168.1.20/32 برای یک دستگاه و 192.168.1.0/24 برای یک زیرشبکه. برای فهرست پیش‌فرض خالی بگذارید. برای ثابت ماندن نگاشت، به دستگاه‌ها اجارهٔ ثابت DHCP بدهید."

msgid "Active liveness (seconds)"
msgstr "بررسی زنده‌بودن گرهٔ فعال (ثانیه)"

msgid "Failure retry (seconds)"
msgstr "تلاش مجدد پس از خرابی (ثانیه)"

