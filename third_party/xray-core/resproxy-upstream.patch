 	preConns chan *ConnExpire
 }
 
+// A fixed-size limiter keeps a broken active server from creating a socket
+// operation for every client connection. Hash collisions only defer hints;
+// independent periodic HTTPS checks remain the correctness fallback.
+type sbFailureSlot struct {
+	sync.Mutex
+	last time.Time
+}
+
+var sbFailureSlots [64]sbFailureSlot
+
+// This best-effort local hint never selects an outbound. The gateway confirms
+// the active path and its underlay with independent HTTPS probes. No target
+// address, credentials, or user data are sent across the socket.
+func signalSBServerFailure(ctx context.Context, tag, stage string) {
+	if inbound := session.InboundFromContext(ctx); inbound != nil && strings.HasPrefix(inbound.Tag, "outbound-health-") {
+		return
+	}
+	path := os.Getenv("SB_XRAY_FAILURE_SOCKET")
+	if path == "" || tag == "" {
+		return
+	}
+	index := uint64(1469598103934665603)
+	for i := range len(tag) {
+		index = (index ^ uint64(tag[i])) * 1099511628211
+	}
+	slot := &sbFailureSlots[index%uint64(len(sbFailureSlots))]
+	now := time.Now()
+	slot.Lock()
+	if now.Sub(slot.last) < 250*time.Millisecond {
+		slot.Unlock()
+		return
+	}
+	slot.last = now
+	slot.Unlock()
+	message, err := json.Marshal(struct {
+		Version int    `json:"v"`
+		PID     int    `json:"pid"`
+		Tag     string `json:"tag"`
+		Stage   string `json:"stage"`
+	}{1, os.Getpid(), tag, stage})
+	if err != nil || len(message) > 512 {
+		return
+	}
+	connection, err := stdnet.DialTimeout("unixgram", path, 10*time.Millisecond)
+	if err != nil {
+		return
+	}
+	defer connection.Close()
+	_ = connection.SetWriteDeadline(time.Now().Add(10 * time.Millisecond))
+	_, _ = connection.Write(message)
+}
+
 type ConnExpire struct {
 	Conn   stat.Connection
 	Expire time.Time
