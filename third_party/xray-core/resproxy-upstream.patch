@@ -0,0 +1,49 @@
+package proxy
+
+import (
+	"bytes"
+	"context"
+	"testing"
+
+	"github.com/xtls/xray-core/common/buf"
+)
+
+func TestXtlsPaddingPreservesFullBuffer(t *testing.T) {
+	payload := bytes.Repeat([]byte{0x5a}, buf.Size)
+	tests := []struct {
+		name string
+		uuid []byte
+	}{
+		{name: "uuid already sent"},
+		{name: "first frame", uuid: bytes.Repeat([]byte{0x7b}, 16)},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			input := buf.New()
+			if written, err := input.Write(payload); err != nil || written != len(payload) {
+				t.Fatalf("write full input: written=%d err=%v", written, err)
+			}
+			uuid := append([]byte(nil), test.uuid...)
+			result := XtlsPadding(
+				input,
+				CommandPaddingContinue,
+				&uuid,
+				false,
+				context.Background(),
+				[]uint32{900, 500, 900, 1},
+			)
+			defer result.Release()
+
+			headerLen := len(test.uuid) + 5
+			if got, want := int(result.Len()), headerLen+len(payload); got != want {
+				t.Fatalf("padded length=%d, want %d", got, want)
+			}
+			if !bytes.Equal(result.BytesRange(int32(headerLen), result.Len()), payload) {
+				t.Fatal("full input payload was not preserved")
+			}
+			if uuid != nil {
+				t.Fatal("UUID was not consumed")
+			}
+		})
+	}
+}
diff --git a/transport/internet/dialer_lifecycle.go b/transport/internet/dialer_lifecycle.go
new file mode 100755
index 0000000..c596d78
--- /dev/null
+++ b/transport/internet/dialer_lifecycle.go
@@ -0,0 +1,79 @@
+package internet
+
+import "sync"
+
+// A removed outbound may still have live streams or a Dispatch which already
+// obtained its handler. Retire the cache only after those streams release it.
+// The state belongs to the stream configuration, never to a global registry.
+type dialerLifetime struct {
+	mu       sync.Mutex
+	active   int
+	retired  bool
+	cleaning chan struct{}
+	cleanups map[any]func()
+}
+
+// AcquireDialer keeps transport resources alive until the returned function is
+// called. Late users of an already removed handler get their own cleanup cycle.
+func (s *MemoryStreamConfig) AcquireDialer() func() {
+	d := &s.dialers
+	d.mu.Lock()
+	for d.cleaning != nil {
+		finished := d.cleaning
+		d.mu.Unlock()
+		<-finished
+		d.mu.Lock()
+	}
+	d.active++
+	d.mu.Unlock()
+	var once sync.Once
+	return func() { once.Do(func() { d.finish(false) }) }
+}
+
+// RegisterDialerCleanup is called while holding a dialer lease and before
+// acquiring a transport cache lock. A key is registered only once per cycle.
+func (s *MemoryStreamConfig) RegisterDialerCleanup(key any, cleanup func()) {
+	d := &s.dialers
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	if d.cleanups == nil {
+		d.cleanups = make(map[any]func())
+	}
+	if _, exists := d.cleanups[key]; !exists {
+		d.cleanups[key] = cleanup
+	}
+}
+
+// RetireDialers prevents idle caches from keeping an obsolete outbound alive.
+// Active streams drain normally; this is deliberately different from Close.
+func (s *MemoryStreamConfig) RetireDialers() {
+	if s != nil {
+		s.dialers.finish(true)
+	}
+}
+
+func (d *dialerLifetime) finish(retire bool) {
+	d.mu.Lock()
+	if retire {
+		d.retired = true
+	} else {
+		d.active--
+	}
+	if !d.retired || d.active != 0 || d.cleaning != nil || len(d.cleanups) == 0 {
+		d.mu.Unlock()
+		return
+	}
+	cleanups := d.cleanups
+	d.cleanups = nil
+	d.cleaning = make(chan struct{})
+	d.mu.Unlock()
+	// No user can acquire this cache while its old connections are closing.
+	// Run callbacks outside the lifetime lock to avoid transport lock inversion.
+	for _, cleanup := range cleanups {
+		cleanup()
+	}
+	d.mu.Lock()
+	close(d.cleaning)
+	d.cleaning = nil
+	d.mu.Unlock()
+}
diff --git a/transport/internet/dialer_lifecycle_test.go b/transport/internet/dialer_lifecycle_test.go
new file mode 100755
index 0000000..6e824ae
--- /dev/null
+++ b/transport/internet/dialer_lifecycle_test.go
@@ -0,0 +1,111 @@
+package internet
+
+import (
+	"runtime"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+	"weak"
+)
+
+func TestDialerRetirementDrainsAndReclaimsLateUse(t *testing.T) {
+	settings := &MemoryStreamConfig{}
+	var closed atomic.Int32
+	first, second := settings.AcquireDialer(), settings.AcquireDialer()
+	settings.RegisterDialerCleanup("resource", func() { closed.Add(1) })
+	settings.RetireDialers()
+	first()
+	first()
+	if closed.Load() != 0 {
+		t.Fatal("retirement closed a cache with a live connection")
+	}
+	second()
+	if closed.Load() != 1 {
+		t.Fatal("last stream did not reclaim the cache")
+	}
+	for range 1000 {
+		release := settings.AcquireDialer()
+		settings.RegisterDialerCleanup("resource", func() { closed.Add(1) })
+		release()
+	}
+	if closed.Load() != 1001 || settings.dialers.active != 0 || len(settings.dialers.cleanups) != 0 {
+		t.Fatal("late streams of a retired handler leaked resources")
+	}
+}
+
+func TestDialerRetirementSerializesLateAcquireWithCleanup(t *testing.T) {
+	settings := &MemoryStreamConfig{}
+	started, finish := make(chan struct{}), make(chan struct{})
+	release := settings.AcquireDialer()
+	settings.RegisterDialerCleanup("resource", func() { close(started); <-finish })
+	settings.RetireDialers()
+	released := make(chan struct{})
+	go func() { release(); close(released) }()
+	<-started
+	acquired := make(chan struct{})
+	go func() { done := settings.AcquireDialer(); close(acquired); done() }()
+	select {
+	case <-acquired:
+		t.Fatal("late stream acquired a cache while it was closing")
+	case <-time.After(20 * time.Millisecond):
+	}
+	close(finish)
+	<-released
+	select {
+	case <-acquired:
+	case <-time.After(time.Second):
+		t.Fatal("late stream did not resume after cleanup")
+	}
+}
+
+func TestDialerRetirementConcurrentStreams(t *testing.T) {
+	settings := &MemoryStreamConfig{}
+	var live atomic.Int32
+	var wg sync.WaitGroup
+	for range 12 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for range 100 {
+				release := settings.AcquireDialer()
+				live.Add(1)
+				settings.RegisterDialerCleanup("shared", func() {
+					if live.Load() != 0 {
+						t.Error("closed an in-use cache")
+					}
+				})
+				live.Add(-1)
+				release()
+			}
+		}()
+	}
+	settings.RetireDialers()
+	wg.Wait()
+	if settings.dialers.active != 0 || len(settings.dialers.cleanups) != 0 {
+		t.Fatal("retired cache retained stream leases")
+	}
+}
+
+func TestDialerRetirementDoesNotKeepConfigurationsAlive(t *testing.T) {
+	makeRetired := func() weak.Pointer[MemoryStreamConfig] {
+		settings := &MemoryStreamConfig{}
+		release := settings.AcquireDialer()
+		settings.RegisterDialerCleanup("self", func() { runtime.KeepAlive(settings) })
+		settings.RetireDialers()
+		release()
+		return weak.Make(settings)
+	}
+	refs := make([]weak.Pointer[MemoryStreamConfig], 1000)
+	for i := range refs {
+		refs[i] = makeRetired()
+	}
+	// Live objects, not RSS: the Go allocator may retain reusable pages after
+	// collection without leaking any configuration or transport client.
+	runtime.GC()
+	for _, ref := range refs {
+		if ref.Value() != nil {
+			t.Fatal("retirement retained an obsolete configuration")
+		}
+	}
+}
